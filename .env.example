# Secure-by-default. For local development explicitly set APP_ENV=dev.
APP_ENV=prod
DATABASE_URL=sqlite:///./jijin.db
TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO
INTERNAL_API_TOKEN=
LIVE_TRADING_ENABLED=false

# Human API credentials. Use a strong server-side random secret; never share it with clients.
API_CREDENTIAL_PEPPER=
API_CREDENTIAL_DEFAULT_TTL_DAYS=90
API_CREDENTIAL_MAX_TTL_DAYS=365

# AI providers (OpenAI-compatible endpoints)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=

# AI quota and estimated-cost controls. Provider rates are in AI_COST_CURRENCY per 1M tokens.
AI_COST_CURRENCY=CNY
AI_MAX_SOURCE_CHARS=100000
AI_MAX_REQUEST_CHARS=120000
AI_MAX_OUTPUT_TOKENS=4096
AI_DAILY_MAX_CALLS_PER_SUBJECT=30
AI_DAILY_MAX_ESTIMATED_COST=50
DEEPSEEK_INPUT_COST_PER_MILLION=0
DEEPSEEK_OUTPUT_COST_PER_MILLION=0
QWEN_INPUT_COST_PER_MILLION=0
QWEN_OUTPUT_COST_PER_MILLION=0
KIMI_INPUT_COST_PER_MILLION=0
KIMI_OUTPUT_COST_PER_MILLION=0

# V1.3 research inbox/pipeline. Scheduler processes trusted inbox material at 13:15.
RESEARCH_PROCESSING_STALE_MINUTES=30
RESEARCH_PIPELINE_BATCH_SIZE=5
RESEARCH_PIPELINE_MAX_ATTEMPTS=5

# Feishu / Lark. Enable only after all signing credentials are present.
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_WEBHOOK_URL=
FEISHU_REPLAY_WINDOW_SECONDS=300
FEISHU_SESSION_TTL_MINUTES=30

# Product defaults — engineering defaults, not regulatory rules.
DEFAULT_CUTOFF_BUFFER_MINUTES=10
ORDER_STALE_MINUTES=60
OPERATIONAL_RUN_STALE_MINUTES=30
RISK_PROFILE_VALID_DAYS=365
NAV_RED_AFTER_HOURS=72
NAV_YELLOW_AFTER_HOURS=36
DATA_SOURCE_CONFLICT_WINDOW_MINUTES=15
MAX_SINGLE_FUND_WEIGHT=0.20
MAX_DAILY_TRADE_RATIO=0.30
MAX_PORTFOLIO_DRAWDOWN=0.12
MAX_CONSECUTIVE_LOSS_DAYS=5
SHORT_HOLD_DAYS=7
