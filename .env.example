APP_ENV=dev
DATABASE_URL=sqlite:///./jijin.db
TIMEZONE=Asia/Shanghai

# AI providers (OpenAI-compatible endpoints)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=

# Feishu / Lark
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_WEBHOOK_URL=

# Product defaults — engineering defaults, not regulatory rules.
DEFAULT_CUTOFF_BUFFER_MINUTES=10
ORDER_STALE_MINUTES=60
RISK_PROFILE_VALID_DAYS=365
NAV_RED_AFTER_HOURS=72
NAV_YELLOW_AFTER_HOURS=36
MAX_SINGLE_FUND_WEIGHT=0.20
MAX_DAILY_TRADE_RATIO=0.30
MAX_PORTFOLIO_DRAWDOWN=0.12
MAX_CONSECUTIVE_LOSS_DAYS=5
SHORT_HOLD_DAYS=7
