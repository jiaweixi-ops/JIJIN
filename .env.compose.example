# Copy to .env before using docker compose, then replace every placeholder.
APP_ENV=prod
TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO
LIVE_TRADING_ENABLED=false

# Required application authentication. Use a long random value.
INTERNAL_API_TOKEN=

# PostgreSQL container settings. Do not use example/dev passwords in production.
POSTGRES_DB=jijin
POSTGRES_USER=jijin
POSTGRES_PASSWORD=
DATABASE_URL=
# Example format only (URL-encode special characters in the password):
# DATABASE_URL=postgresql+psycopg://jijin:<encoded-password>@postgres:5432/jijin

# Bind only to loopback by docker-compose.yml; change the port if needed.
JIJIN_API_PORT=8000

# AI providers
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=

# Feishu / Lark
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_WEBHOOK_URL=
FEISHU_REPLAY_WINDOW_SECONDS=300
FEISHU_SESSION_TTL_MINUTES=30
