# Copy to .env before using docker compose, then replace every placeholder.
APP_ENV=prod
TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO
LIVE_TRADING_ENABLED=false

# Required application authentication. Use long independent random values.
INTERNAL_API_TOKEN=
API_CREDENTIAL_PEPPER=
API_CREDENTIAL_DEFAULT_TTL_DAYS=90
API_CREDENTIAL_MAX_TTL_DAYS=365

# PostgreSQL container settings. Do not use example/dev passwords in production.
POSTGRES_DB=jijin
POSTGRES_USER=jijin
POSTGRES_PASSWORD=
DATABASE_URL=
# Example format only (URL-encode special characters in the password):
# DATABASE_URL=postgresql+psycopg://jijin:<encoded-password>@postgres:5432/jijin

# Bind only to loopback by docker-compose.yml; change the port if needed.
JIJIN_API_PORT=8000

# AI providers. The V1.3 RC field preflight requires all three key+model pairs.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=

# AI quotas and estimated cost. Rates are in AI_COST_CURRENCY per 1M tokens.
AI_COST_CURRENCY=CNY
AI_MAX_SOURCE_CHARS=100000
AI_MAX_REQUEST_CHARS=120000
AI_MAX_OUTPUT_TOKENS=4096
AI_DAILY_MAX_CALLS_PER_SUBJECT=30
AI_DAILY_MAX_ESTIMATED_COST=50
DEEPSEEK_INPUT_COST_PER_MILLION=0
DEEPSEEK_OUTPUT_COST_PER_MILLION=0
QWEN_INPUT_COST_PER_MILLION=0
QWEN_OUTPUT_COST_PER_MILLION=0
KIMI_INPUT_COST_PER_MILLION=0
KIMI_OUTPUT_COST_PER_MILLION=0

# V1.3 durable operations and research pipeline.
DEFAULT_CUTOFF_BUFFER_MINUTES=10
ORDER_STALE_MINUTES=60
OPERATIONAL_RUN_STALE_MINUTES=30
RESEARCH_PROCESSING_STALE_MINUTES=30
RESEARCH_PIPELINE_BATCH_SIZE=5
RESEARCH_PIPELINE_MAX_ATTEMPTS=5

# V1.3 explicitly registered RSS/Atom/JSON Feed collection.
RESEARCH_COLLECTION_TIMEOUT_SECONDS=15
RESEARCH_COLLECTION_MAX_BYTES=2000000
RESEARCH_COLLECTION_MAX_REDIRECTS=3
RESEARCH_COLLECTION_MAX_ITEMS_PER_SOURCE=20
RESEARCH_COLLECTION_BATCH_SIZE=20
RESEARCH_COLLECTION_ALLOW_HTTP=false

# V1.3 multi-source fund/day dossier assembly.
RESEARCH_DOSSIER_LOOKBACK_HOURS=72
RESEARCH_DOSSIER_MAX_MATERIALS=12
RESEARCH_DOSSIER_MAX_CHARS=80000

# V1.3 explicitly registered fund-data connectors.
FUND_DATA_TIMEOUT_SECONDS=15
FUND_DATA_MAX_BYTES=5000000
FUND_DATA_MAX_REDIRECTS=3
FUND_DATA_MAX_FUNDS_PER_SYNC=5000
FUND_DATA_CONNECTOR_BATCH_SIZE=20
FUND_DATA_ALLOW_HTTP=false

# Data-quality, forward-review and deterministic risk settings. Freeze these for
# an observation epoch; material behavior changes should start a new RC epoch.
DATA_SOURCE_CONFLICT_WINDOW_MINUTES=15
DECISION_REVIEW_HORIZONS_DAYS=5,20,60
RISK_PROFILE_VALID_DAYS=365
NAV_RED_AFTER_HOURS=72
NAV_YELLOW_AFTER_HOURS=36
MAX_SINGLE_FUND_WEIGHT=0.20
MAX_DAILY_TRADE_RATIO=0.30
MAX_PORTFOLIO_DRAWDOWN=0.12
MAX_CONSECUTIVE_LOSS_DAYS=5
SHORT_HOLD_DAYS=7

# Feishu / Lark. Field observation can run without Feishu, but the intended RC
# should enable it so human confirmation and operational alert delivery are exercised.
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_WEBHOOK_URL=
FEISHU_REPLAY_WINDOW_SECONDS=300
FEISHU_SESSION_TTL_MINUTES=30
